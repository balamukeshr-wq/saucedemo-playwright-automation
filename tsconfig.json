{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "tests",
    "pages",
    "data",
    "playwright.config.ts"
  ]
}